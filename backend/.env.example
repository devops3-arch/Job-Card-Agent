# ─── Job Card Agent — backend configuration ──────────────────────────────────
# Copy to backend/.env for local work. In production these are App Service
# application settings, not a file — .env is gitignored and never deployed.
#
# Never point a local .env at the production database. Create a local one:
#   createdb jobcard_dev
#   psql jobcard_dev -f backend/schema.sql
#   cd backend && npm run migrate && npm run seed:admin && npm run seed:demo

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001
LOG_LEVEL=info

# ─── Database (required) ─────────────────────────────────────────────────────
# Either a single connection string...
DATABASE_URL=postgresql://localhost:5432/jobcard_dev
# ...or the discrete variables, used when DATABASE_URL is unset.
PGHOST=localhost
PGPORT=5432
PGDATABASE=jobcard_dev
PGUSER=postgres
PGPASSWORD=
# "require" for Azure Postgres, "disable" locally.
PGSSLMODE=disable

# ─── Tokens (required — the server refuses to start without a signing key) ────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
# Legacy fallback, only read when ACCESS_TOKEN_SECRET is absent.
JWT_SECRET=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. In production this is the
# entire policy; localhost and LAN origins are only accepted outside production.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
FRONTEND_URL=http://localhost:8080

# ─── File storage ────────────────────────────────────────────────────────────
# "local" writes into backend/uploads, which does not survive a redeploy and is
# not shared between instances. Use "azure" for anything you need to keep.
STORAGE_PROVIDER=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_SIGNATURES=signatures
AZURE_STORAGE_CONTAINER_DOCUMENTS=approved-documents
AZURE_STORAGE_CONTAINER_REPORTS=job-evidence

# ─── Background workers ──────────────────────────────────────────────────────
# Notifications are only processed while this is "true".
WORKER_ENABLED=false
WORKER_POLL_INTERVAL_MS=5000

# ─── Email delivery ──────────────────────────────────────────────────────────
# Without SMTP_HOST, notifications are queued and recorded but not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Job Card Agent <no-reply@bhatiabrothers.com>"

# ─── Optional integrations ───────────────────────────────────────────────────
# Without a key the AI endpoints still respond, using fallback logic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
N8N_JOB_APPROVAL_WEBHOOK_URL=

# ─── Tuning ──────────────────────────────────────────────────────────────────
# Requests per IP per 15 minutes, excluding static assets. Remember that an
# office behind one NAT shares a single budget.
GLOBAL_RATE_LIMIT_MAX=1000
# Swagger UI is served outside production automatically; set this to expose it
# in production as well.
ENABLE_API_DOCS=false

# ─── Zoho Books ──────────────────────────────────────────────────────────────
# Without all four, invoice push is inert and reports "not_configured".
# Create a self-client in the Zoho API console, then exchange for a refresh token.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
# Data centre suffix: com (default), eu, in, com.au, jp, ca
ZOHO_DC=com

# Failed login attempts per 15 minutes, per account per IP. Keyed per account so
# one user's mistakes cannot lock out an office sharing a NAT.
AUTH_RATE_LIMIT_MAX=10
